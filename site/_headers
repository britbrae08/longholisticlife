# Cache content-hashed generated assets immutably.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Hand-written mobile form hotfixes are intentionally not immutable.
/assets/omnisend-mobile-fix.js
  Cache-Control: no-store, max-age=0

/assets/omnisend-mobile-safe-v2.js
  Cache-Control: no-store, max-age=0
