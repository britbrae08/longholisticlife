# Baseline security/trust headers without blocking Omnisend or other required scripts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Cache content-hashed generated assets immutably.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Hand-written mobile form hotfixes are intentionally not immutable.
/assets/omnisend-mobile-fix.js
  Cache-Control: no-store, max-age=0

/assets/omnisend-mobile-safe-v2.js
  Cache-Control: no-store, max-age=0

# Welcome-page navigation fixes must always be fetched fresh while we iterate.
/assets/welcome-top-fix-v4.js
  Cache-Control: no-store, max-age=0

# Keep downloadable lead-magnet PDFs out of search results so they do not bypass the opt-in landing page.
/guides/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
